# Maintainer: Shaun Alan Joseph <shaun.alan.joseph.s@gmail.com>

pkgname=cdeez
pkgver=1.0.0
pkgrel=1
pkgdesc='A cd that learns where you go, and forgives how you type'
arch=('x86_64')
url='https://github.com/ShaunAlanJoseph/CDeez'
license=('MIT')
depends=('sqlite' 'gcc-libs' 'glibc')
options=('!debug')
makedepends=('cmake' 'ninja' 'scdoc' 'catch2')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "CDeez-$pkgver"

  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS" \
    -Wno-dev
  cmake --build build
}

check() {
  cd "CDeez-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "CDeez-$pkgver"

  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
